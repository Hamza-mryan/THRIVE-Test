**/bin/
**/obj/
**/node_modules/
**/.angular/
**/dist/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/
**/TestResults/
**/test-results/
**/playwright-report/
**/.gradle/
**/local.properties
**/Pods/
**/.symlinks/
**/ephemeral/

# Local-only output and databases.
/THRIVE/.local/
/THRIVE/output/
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.dump
**/*.backup
**/.DS_Store
