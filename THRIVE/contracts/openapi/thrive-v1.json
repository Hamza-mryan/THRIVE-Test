  "components": {
    "schemas": {
      "ActivitySummaryResponse": {
        "required": [
          "completedScreenings",
          "inProgressScreenings",
          "openReferrals",
          "latestScreeningAtUtc"
        ],
        "type": "object",
        "properties": {
          "completedScreenings": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "inProgressScreenings": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "openReferrals": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "latestScreeningAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AggregateReportResponse": {
        "required": [
          "screeningsCount",
          "referralsCount",
          "completedReferralsCount",
          "minCellSize",
          "availableResourcesCount",
          "availableServicesCount"
        ],
        "type": "object",
        "properties": {
          "screeningsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "referralsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "completedReferralsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
