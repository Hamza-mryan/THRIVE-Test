# Generated reference extraction is local review material, not application source.
/reference-review/

# Local secrets and environment overrides.
**/.env
**/.env.local
**/.env.*.local
**/appsettings.Local.json
**/appsettings.Development.local.json
**/.env.*
!**/.env.example
**/*.user
**/*.suo
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.jks
**/*.keystore

